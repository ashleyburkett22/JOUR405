library(tidyverse)
library(dplyr)
MMs_data <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/mandms.csv")
set.seed(22)
sample5 <- MMs_data |>
sample_n(5)
sample10 <- MMs_data |>
sample_n(10)
MMs_data |>
summarise(
mean = mean(red),
median = median(red),
sd = sd(red),
)
MMs_data |>
ggplot(aes(x=red)) +
geom_histogram(aes(x = red), binwidth = 0.9) +
labs(title = "Distribution of Red M&Ms", x = "Red", y = "Frequency")
sample10 |>
ggplot(aes(x=red)) +
geom_histogram(aes(x = red), binwidth = 0.9) +
labs(title = "Distribution of Red M&Ms Out of Ten", x = "Red", y = "Frequency")
